DERIVA_CHATBOT_CLIENT_ID=deriva-chatbot
DERIVA_CHATBOT_STORAGE_BACKEND=sqlite
DERIVA_CHATBOT_STORAGE_BACKEND_URL=sqlite:///var/lib/deriva-chatbot/sessions.db
DERIVA_CHATBOT_MAX_HISTORY_TURNS=20
DERIVA_CHATBOT_SESSION_TTL=28800
DERIVA_CHATBOT_BEHIND_PROXY=true
DERIVA_CHATBOT_APP_USE_SYSLOG=true
DERIVA_CHATBOT_AUDIT_USE_SYSLOG=true
DERIVA_CHATBOT_ACCESS_USE_SYSLOG=true
DERIVA_CHATBOT_ALLOW_ANONYMOUS=true
DERIVA_CHATBOT_RAG_ONLY_WHEN_ANONYMOUS=true
DERIVA_CHATBOT_DEBUG=true

DERIVA_CHATBOT_CODE_THEME="vs2015" # github atom-one-light stackoverflow-light atom-one-dark vs2015 github-dark monokai dracula nord
DERIVA_CHATBOT_CHAT_BG_COLOR="#f8f9f9"
#DERIVA_CHATBOT_HEADER_BG_COLOR="#414141"
#DERIVA_CHATBOT_INPUT_AREA_BG_COLOR="#5a5a5a"

#DERIVA_CHATBOT_LLM_MODEL=claude-sonnet-4-6
#DERIVA_CHATBOT_LLM_PROVIDER=
#DERIVA_CHATBOT_LLM_API_KEY=
#DERIVA_CHATBOT_LLM_API_BASE=

#DERIVA_CHATBOT_AUDIT_DIAGNOSTIC=true
#DERIVA_CHATBOT_AUDIT_DIAGNOSTIC_COMPRESS_RESPONSE=true
#DERIVA_CHATBOT_AUDIT_DIAGNOSTIC_RESPONSE_MAX_CHARS=500
#DERIVA_CHATBOT_AUDIT_DIAGNOSTIC_TOOL_OUTPUT_MAX_CHARS=200

#DERIVA_CHATBOT_DEFAULT_HOSTNAME=staging.facebase.org
#DERIVA_CHATBOT_DEFAULT_CATALOG_ID=1
#DERIVA_CHATBOT_DEFAULT_CATALOG_LABEL="FaceBase Staging"
#DERIVA_CHATBOT_HEADER_LOGO_URL="https://www.facebase.org/assets/img/logo_facebase_white.png"
