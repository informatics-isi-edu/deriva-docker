DERIVA_MCP_RAG_ENABLED=true
DERIVA_MCP_RAG_DATA_DIR=/var/lib/deriva-mcp/data
DERIVA_MCP_AUDIT_USE_SYSLOG=true
DERIVA_MCP_ACCESS_USE_SYSLOG=true
DERIVA_CHATBOT_BEHIND_PROXY=true
DERIVA_MCP_DISABLE_MUTATING_TOOLS=false
DERIVA_MCP_ALLOW_ANONYMOUS=true
DERIVA_MCP_DEBUG=true
DERIVA_MCP_PLUGIN_ALLOWLIST=facebase,deriva-ml-mcp

#FACEBASE_DERIVA_MCP_PLUGIN_HOSTNAME=staging.facebase.org
#FACEBASE_DERIVA_MCP_PLUGIN_MAX_INDEXED_WEB_PAGES=400
#FACEBASE_DERIVA_MCP_PLUGIN_MAX_INDEXED_DATASET_RECORDS=100
