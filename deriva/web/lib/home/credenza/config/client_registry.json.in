{
  "version": "0.1",
  "clients": {
    "deriva-py": {
      "desc": "DERIVA Python CLI/API",
      "enabled": true,
      "public": true,
      "allowed_grant_types": [
        "device_code",
        "client_credentials"
      ],
      "allowed_resources": [
        "urn:deriva:rest:service:all"
      ],
      "max_session_ttl_seconds": 7200
    },

    "deriva-mcp": {
      "desc": "Deriva MCP Server (confidential)",
      "enabled": true,
      "adapter": {
        "name": "client_secret",
        "client_secret_hash": "${HASHED_DERIVA_MCP_CLIENT_SECRET}"
      },
      "allowed_grant_types": [
        "authorization_code",
        "client_credentials",
        "token_exchange"
      ],
      "allowed_auth_methods": [
        "client_secret_basic",
        "client_secret_post"
      ],
      "allowed_redirect_uris": [
        "http://localhost:8080/callback",
        "https://claude.ai/api/mcp/auth_callback"
      ],
      "allowed_scopes": [
        "openid",
        "email",
        "profile",
        "claudeai"
      ],
      "allowed_token_exchange_targets": [
        "urn:deriva:rest:service:all"
      ],
      "allowed_resources": [
        "urn:deriva:rest:service:all",
        "https://localhost/mcp"
      ],
      "require_consent": true,
      "consent_display_name": "DERIVA MCP Server",
      "consent_labels": {
        "https://localhost/mcp": "Connect to the DERIVA MCP Server at this URL"
      },
      "max_session_ttl_seconds": 28800,
      "additional_claims": {
        "name": "Deriva MCP Client App",
        "email": "isrd-support@isi.edu"
      }
    },

    "deriva-chatbot": {
      "desc": "DERIVA Chatbot (public, PKCE-only)",
      "enabled": true,
      "public": true,
      "allowed_grant_types": [
        "authorization_code"
      ],
      "allowed_redirect_uris": [
        "https://localhost/chatbot/callback"
      ],
      "allowed_resources": [
        "urn:deriva:rest:service:all",
        "https://localhost/mcp"
      ],
      "allowed_scopes": [
        "openid",
        "email",
        "profile"
      ],
      "require_consent": true,
      "consent_display_name": "DERIVA Chatbot Server",
      "consent_labels": {
        "https://localhost/mcp": "Connect to the DERIVA MCP Server at this URL"
      },
      "max_session_ttl_seconds": 28800
    }
  }
}