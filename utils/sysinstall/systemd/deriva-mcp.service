# systemd unit for the deriva lean MCP stack (mcp-core + mcp-ui + credenza + traefik).
#
# Installation (run as root from the repo root - use /opt/deriva-docker/deriva
#                or adjust WorkingDirectory if different):
#
#   1. Generate the env file and install the symlink to the well-known path:
#        utils/generate-env.sh --env prod --hostname <host> --email <email> \
#          --enable-mcp-aws --llm-api-key <key> --install
#      This writes ~/.deriva-docker/env/<host>.env and symlinks it to
#      /etc/deriva-docker/deriva-stack.env automatically.
#
#   2. Provision the host and install the stack service:
#        utils/sysinstall/bin/install-mcp-stack.sh
#
#   3. Start the stack:
#        systemctl start deriva-mcp
#
#   4. Update the stack (rebuild images and restart):
#        update-stack.sh deriva-mcp
#
#   5. View logs:
#        journalctl -u deriva-mcp -f          # systemd journal (startup/stop events)
#        # Application logs go to CloudWatch (see AWS_LOG_GROUP in env file)
#
# Notes:
#   - WorkingDirectory must be the deriva/ subdirectory of the repo checkout so
#     that relative paths in COMPOSE_FILE (docker-compose.yml:docker-compose-mcp-aws.yml)
#     resolve correctly.
#   - Adjust WorkingDirectory if the repo is cloned to a different location.
#   - Requires Docker Engine with the Compose v2 plugin; installed by install-all.sh.

[Unit]
Description=DERIVA MCP Stack (mcp-core + mcp-ui + credenza + traefik)
Documentation=https://github.com/informatics-isi-edu/deriva-docker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Allow 3 restart attempts within 5 minutes before giving up and entering
# failed state. Use 'systemctl reset-failed deriva-mcp' to clear and retry.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes

# Repo checkout location -- adjust if cloned elsewhere.
WorkingDirectory=/opt/deriva-docker/deriva

# Generated env file from utils/generate-env.sh --enable-mcp-aws.
EnvironmentFile=/etc/deriva-docker/deriva-stack.env

ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStop=/usr/bin/docker compose down

# Wait 10s between restart attempts.
Restart=on-failure
RestartSec=10s

# Give containers time to stop cleanly before systemd kills the process.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target