# systemd unit for the deriva lean MCP stack (mcp-core + mcp-ui + credenza + traefik).
#
# Installation (run as root, clone once):
#
#   git clone <repo-url> /root/deriva-docker && cd /root/deriva-docker
#
#   1. Mount EBS and configure Docker data-root on /data:
#        utils/sysinstall/bin/install-system.sh
#
#   2. Generate the env file with secrets on /data (persists across root volume
#      replacement), then install the symlink to the well-known path:
#        utils/generate-env.sh --env prod --hostname <host> --email <email> \
#          --enable-mcp-aws --llm-api-key <key> \
#          --output-dir /data/deriva-docker/.env --install
#      To reuse an existing env instead, copy it to /data/deriva-docker/.env/
#      and symlink manually to /etc/deriva-docker/deriva-stack.env.
#
#   3. Install the stack (copies repo to /data/deriva-docker, pre-builds images):
#        utils/sysinstall/bin/install-mcp-stack.sh
#
#   4. Start the stack:
#        systemctl start deriva-mcp
#
#   5. Update the stack (rebuild images and restart):
#        update-stack.sh deriva-mcp
#
#   6. View logs:
#        journalctl -u deriva-mcp -f          # systemd journal (startup/stop events)
#        # Application logs go to CloudWatch (see AWS_LOG_GROUP in env file)
#
# Notes:
#   - Tested baseline: t3.large (2 vCPU, 8 GB RAM) + 8 GB swapfile. Swap is a
#     safety net for chromadb/RAG memory spikes; sustained swap usage is a signal
#     to upsize. Configure via SWAPFILE and SWAPFILE_SIZE in deriva-stack.env.
#   - WorkingDirectory must be the deriva/ subdirectory of the repo so that
#     relative paths in COMPOSE_FILE resolve correctly.
#   - Requires Docker Engine with the Compose v2 plugin; installed by install-mcp-stack.sh.

[Unit]
Description=DERIVA MCP Stack (mcp-core + mcp-ui + credenza + traefik)
Documentation=https://github.com/informatics-isi-edu/deriva-docker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Allow 3 restart attempts within 5 minutes before giving up and entering
# failed state. Use 'systemctl reset-failed deriva-mcp' to clear and retry.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes

WorkingDirectory=/data/deriva-docker/deriva

# Generated env file from utils/generate-env.sh --enable-mcp-aws.
EnvironmentFile=/etc/deriva-docker/deriva-stack.env

ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStop=/usr/bin/docker compose down

# Wait 10s between restart attempts.
Restart=on-failure
RestartSec=10s

# Give containers time to stop cleanly before systemd kills the process.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target